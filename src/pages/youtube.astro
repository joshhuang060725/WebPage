---
import PortalLayout from "@layouts/PortalLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import Localized from "@components/Localized.astro";
import StatusBadge from "@components/StatusBadge.astro";

const title = { en: "YouTube Browser", "zh-TW": "YouTube 瀏覽器", "zh-CN": "YouTube 浏览器" };
const description = {
  en: "A quota-aware YouTube search and embedded playback interface with local caching and explicit failure states.",
  "zh-TW": "具配額保護、本機快取與明確失敗狀態的 YouTube 搜尋及嵌入播放介面。",
  "zh-CN": "具配额保护、本地缓存与明确失败状态的 YouTube 搜索及嵌入播放界面。"
};
---

<PortalLayout title={title} description={description} active="youtube">
  <PageHeader eyebrow={{ en: "MEDIA / CONTROLLED QUERY", "zh-TW": "媒體／受控查詢", "zh-CN": "媒体／受控查询" }} title={title} description={description} />
  <div class="meta-row"><StatusBadge status="beta" /><span class="tag">YouTube Data API</span><span class="tag"><Localized value={{ en: "Search on submit", "zh-TW": "送出才查詢", "zh-CN": "提交才查询" }} /></span></div>
  <section class="section youtube-layout">
    <article class="panel player-panel">
      <div class="player-frame" id="player-frame">
        <div class="empty-state" id="player-empty">
          <strong>JATS / PLAYER</strong>
          <Localized value={{ en: "Choose a search result to begin playback.", "zh-TW": "選擇搜尋結果後開始播放。", "zh-CN": "选择搜索结果后开始播放。" }} tag="p" />
        </div>
      </div>
      <h2 id="now-playing"><Localized value={{ en: "Nothing playing", "zh-TW": "尚未播放", "zh-CN": "尚未播放" }} /></h2>
      <p id="now-channel" class="muted">—</p>
    </article>
    <aside class="panel search-panel">
      <form id="youtube-search">
        <div class="field">
          <label for="youtube-query"><Localized value={{ en: "Search videos", "zh-TW": "搜尋影片", "zh-CN": "搜索视频" }} /></label>
          <input id="youtube-query" name="q" type="search" minlength="1" maxlength="80" required placeholder="Search videos…" autocomplete="off" />
        </div>
        <button class="button primary" type="submit"><Localized value={{ en: "Search", "zh-TW": "搜尋", "zh-CN": "搜索" }} /></button>
      </form>
      <div id="youtube-status" class="notice" aria-live="polite">
        <Localized value={{ en: "Search runs only after submission. Repeated queries may use a one-hour local cache.", "zh-TW": "只有送出後才會查詢；重複搜尋可能使用一小時本機快取。", "zh-CN": "只有提交后才会查询；重复搜索可能使用一小时本地缓存。" }} />
      </div>
      <div id="youtube-results" class="result-list"></div>
    </aside>
  </section>
  <section class="section grid two">
    <article class="panel"><p class="eyebrow">DATA SOURCE</p><Localized value={{ en: "Results are sanitized by a Cloudflare Pages Function. Only video ID, title, channel, thumbnail, and publish time reach this page.", "zh-TW": "結果由 Cloudflare Pages Function 清理；頁面只接收影片 ID、標題、頻道、縮圖與發布時間。", "zh-CN": "结果由 Cloudflare Pages Function 清理；页面只接收视频 ID、标题、频道、缩略图与发布时间。" }} tag="p" /></article>
    <article class="notice warning"><Localized value={{ en: "Playback and thumbnails are provided by YouTube and remain subject to YouTube availability, privacy, and regional rules.", "zh-TW": "播放與縮圖由 YouTube 提供，仍受其服務可用性、隱私與地區規則限制。", "zh-CN": "播放与缩略图由 YouTube 提供，仍受其服务可用性、隐私与地区规则限制。" }} /></article>
  </section>

  <script is:inline slot="scripts">
    const form = document.querySelector("#youtube-search");
    const queryInput = document.querySelector("#youtube-query");
    const status = document.querySelector("#youtube-status");
    const results = document.querySelector("#youtube-results");
    const frame = document.querySelector("#player-frame");
    const nowPlaying = document.querySelector("#now-playing");
    const nowChannel = document.querySelector("#now-channel");
    const cacheKey = (query, lang) => `jats:youtube:${lang}:${query.toLowerCase()}`;
    const currentLanguage = () => document.documentElement.lang || "en";
    const messages = {
      en: { loading: "Searching YouTube…", empty: "No embeddable videos matched this query.", error: "Search is unavailable. Check the API configuration or try again later.", quota: "The public search quota is currently exhausted. Try again later.", cached: "Results loaded from the local cache.", live: "Results loaded from YouTube." },
      "zh-TW": { loading: "正在搜尋 YouTube…", empty: "找不到可嵌入播放的影片。", error: "搜尋目前無法使用，請檢查 API 設定或稍後再試。", quota: "公開搜尋配額目前已用完，請稍後再試。", cached: "已從本機快取載入結果。", live: "已從 YouTube 載入結果。" },
      "zh-CN": { loading: "正在搜索 YouTube…", empty: "找不到可嵌入播放的视频。", error: "搜索目前无法使用，请检查 API 设置或稍后再试。", quota: "公开搜索配额目前已用完，请稍后再试。", cached: "已从本地缓存加载结果。", live: "已从 YouTube 加载结果。" }
    };
    const t = (key) => (messages[currentLanguage()] || messages.en)[key];
    const setStatus = (message, warning = false) => {
      status.textContent = message;
      status.classList.toggle("warning", warning);
    };
    const play = (item) => {
      frame.innerHTML = "";
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(item.id)}?autoplay=1`;
      iframe.title = item.title;
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      frame.append(iframe);
      nowPlaying.textContent = item.title;
      nowChannel.textContent = item.channelTitle || "YouTube";
    };
    const render = (items) => {
      results.innerHTML = "";
      if (!items.length) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = t("empty");
        results.append(empty);
        return;
      }
      items.forEach((item) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "video-result";
        const image = document.createElement("img");
        image.src = item.thumbnail;
        image.alt = "";
        image.loading = "lazy";
        const copy = document.createElement("span");
        const title = document.createElement("strong");
        title.textContent = item.title;
        const meta = document.createElement("small");
        meta.textContent = item.channelTitle || "YouTube";
        copy.append(title, meta);
        button.append(image, copy);
        button.addEventListener("click", () => play(item));
        results.append(button);
      });
    };
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const query = queryInput.value.trim();
      if (!query) return;
      const key = cacheKey(query, currentLanguage());
      try {
        const cached = JSON.parse(localStorage.getItem(key) || "null");
        if (cached && Date.now() - cached.time < 3600000) {
          render(cached.items);
          setStatus(t("cached"));
          return;
        }
      } catch {}
      setStatus(t("loading"));
      results.innerHTML = "";
      try {
        const params = new URLSearchParams({ q: query, lang: currentLanguage(), region: "TW" });
        const response = await fetch(`/api/youtube/search?${params}`);
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          const code = payload?.error?.code || "";
          throw new Error(code.includes("quota") ? "quota" : "error");
        }
        render(payload.items || []);
        localStorage.setItem(key, JSON.stringify({ time: Date.now(), items: payload.items || [] }));
        setStatus(payload.cached ? t("cached") : t("live"));
      } catch (error) {
        setStatus(t(error.message === "quota" ? "quota" : "error"), true);
        render([]);
      }
    });
  </script>
</PortalLayout>

<style>
  .youtube-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, .8fr); gap: 1rem; }
  .player-frame { aspect-ratio: 16 / 9; display: grid; place-items: center; overflow: hidden; background: #030405; border: 1px solid var(--line); }
  .player-frame iframe { width: 100%; height: 100%; border: 0; }
  .player-panel h2 { margin: 1rem 0 .25rem; font-size: 1.2rem; }
  .search-panel form { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: .6rem; }
  .search-panel .notice { margin: 1rem 0; }
  .result-list { max-height: 560px; overflow-y: auto; display: grid; gap: .5rem; }
  .video-result { padding: .5rem; display: grid; grid-template-columns: 116px 1fr; gap: .7rem; text-align: left; }
  .video-result img { width: 116px; aspect-ratio: 16/9; object-fit: cover; background: var(--surface-soft); }
  .video-result span { display: grid; align-content: center; gap: .3rem; }
  .video-result small { color: var(--muted); }
  @media (max-width: 820px) { .youtube-layout { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .search-panel form { grid-template-columns: 1fr; } .video-result { grid-template-columns: 90px 1fr; } .video-result img { width: 90px; } }
</style>
