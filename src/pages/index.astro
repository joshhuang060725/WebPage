---
import PortalLayout from "@layouts/PortalLayout.astro";
import Localized from "@components/Localized.astro";
import "../styles/home.css";

const title = {
  en: "Josh Huang | JATS Personal Portal",
  "zh-TW": "Josh Huang｜JATS 個人入口",
  "zh-CN": "Josh Huang｜JATS 个人入口"
};

const description = {
  en: "Josh Huang's public portal for personal information, project notes, safe links, and browser tools.",
  "zh-TW": "Josh Huang 的公開入口，用於個人介紹、專案筆記、安全連結與瀏覽器工具。",
  "zh-CN": "Josh Huang 的公开入口，用于个人介绍、项目笔记、安全链接与浏览器工具。"
};
---

<PortalLayout title={title} description={description} active="portal">
  <section class="home-terminal panel" aria-labelledby="home-title">
    <div class="home-status-rail" aria-label="Portal status">
      <article class="home-status-card home-time-card">
        <Localized
          value={{ en: "Local time", "zh-TW": "本地時間", "zh-CN": "本地时间" }}
          tag="span"
          class="home-card-label"
        />
        <strong id="home-clock" aria-live="off">--:--:--</strong>
        <small id="home-date">----</small>
      </article>

      <a class="home-status-card" href="/profile.html">
        <Localized
          value={{ en: "Place", "zh-TW": "位置", "zh-CN": "位置" }}
          tag="span"
          class="home-card-label"
        />
        <strong id="home-place" aria-live="polite">
          <Localized
            value={{
              en: "Detecting location",
              "zh-TW": "正在偵測位置",
              "zh-CN": "正在检测位置"
            }}
          />
        </strong>
        <small id="home-place-meta">
          <Localized
            value={{
              en: "IP-based estimate",
              "zh-TW": "IP 估算／時區",
              "zh-CN": "IP 估算／时区"
            }}
          />
        </small>
      </a>

      <article class="home-status-card">
        <Localized
          value={{ en: "Weather", "zh-TW": "天氣", "zh-CN": "天气" }}
          tag="span"
          class="home-card-label"
        />
        <strong id="home-weather" aria-live="polite">
          <Localized
            value={{
              en: "Loading weather",
              "zh-TW": "正在載入天氣",
              "zh-CN": "正在加载天气"
            }}
          />
        </strong>
        <small id="home-weather-meta">
          <Localized
            value={{
              en: "Using estimated location",
              "zh-TW": "使用估算位置",
              "zh-CN": "使用估算位置"
            }}
          />
        </small>
      </article>

      <a
        class="home-status-card"
        href="https://github.com/joshhuang060725"
        target="_blank"
        rel="noreferrer"
      >
        <span class="home-card-label">GitHub</span>
        <strong>joshhuang060725</strong>
        <small>
          <Localized
            value={{
              en: "Public code profile",
              "zh-TW": "公開程式碼資料",
              "zh-CN": "公开代码资料"
            }}
          />
        </small>
      </a>

      <article class="home-status-card">
        <span class="home-card-label">Ping</span>
        <strong id="home-ping" aria-live="polite">
          <Localized
            value={{
              en: "Measuring latency",
              "zh-TW": "正在測量延遲",
              "zh-CN": "正在测量延迟"
            }}
          />
        </strong>
        <small id="home-ping-meta">Cloudflare Pages</small>
      </article>

      <a class="home-status-card" href="/tools.html">
        <span class="home-card-label">Tool</span>
        <strong>
          <Localized
            value={{
              en: "Module entries",
              "zh-TW": "模組入口",
              "zh-CN": "模块入口"
            }}
          />
        </strong>
        <small>Exchange / Compute / UX</small>
      </a>
    </div>

    <aside class="home-jats-console" aria-label="JATS identity">
      <div class="home-jats-lockup">
        <h1 id="home-title">JATS</h1>
        <p>Josh Auxiliary Terminal System</p>
      </div>

      <p class="home-owner-line">- Josh Huang</p>
      <Localized
        value={{
          en: "Keep the interface precise. Keep the system useful.",
          "zh-TW": "讓介面精準，讓系統有用。",
          "zh-CN": "让界面精准，让系统有用。"
        }}
        tag="p"
        class="home-motto"
      />
      <Localized value={description} tag="p" class="home-summary" />

      <form class="home-search" role="search" action="/links.html">
        <label for="home-search-input">
          <Localized
            value={{ en: "Search portal", "zh-TW": "搜尋入口", "zh-CN": "搜索门户" }}
          />
        </label>
        <div class="home-search-control">
          <span aria-hidden="true">J&gt;</span>
          <input
            id="home-search-input"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search modules..."
          />
        </div>
      </form>

      <div class="home-actions">
        <a class="button primary" href="/profile.html">
          <Localized
            value={{
              en: "View profile",
              "zh-TW": "查看個人資料",
              "zh-CN": "查看个人资料"
            }}
          />
        </a>
        <a class="button" href="/projects.html">
          <Localized
            value={{
              en: "Explore projects",
              "zh-TW": "瀏覽專案",
              "zh-CN": "浏览项目"
            }}
          />
        </a>
      </div>

      <p class="home-console-footer">
        <strong>JATS</strong>
        <span>Josh Auxiliary Terminal System</span>
      </p>
    </aside>
  </section>

  <script is:inline slot="scripts">
    (() => {
      const copy = {
        en: {
          detecting: "Detecting location",
          locationEstimate: "IP-based estimate",
          locationUnavailable: "Location unavailable",
          locationDetail: "IP estimate / {timezone}",
          weatherLoading: "Loading weather",
          weatherEstimate: "Using estimated location",
          weatherUnavailable: "Weather unavailable",
          weatherDetail: "Humidity {humidity}% / Wind {wind} km/h",
          pingLoading: "Measuring latency",
          pingUnavailable: "Latency unavailable",
          pingDetail: "Provider: {provider}",
          providerUnknown: "Unknown",
          searchPlaceholder: "Search modules...",
          weather: {
            clear: "Clear",
            cloudy: "Cloudy",
            fog: "Fog",
            drizzle: "Drizzle",
            rain: "Rain",
            snow: "Snow",
            storm: "Storm"
          }
        },
        "zh-TW": {
          detecting: "正在偵測位置",
          locationEstimate: "IP 估算／時區",
          locationUnavailable: "無法取得位置",
          locationDetail: "IP 估算／{timezone}",
          weatherLoading: "正在載入天氣",
          weatherEstimate: "使用估算位置",
          weatherUnavailable: "無法取得天氣",
          weatherDetail: "濕度 {humidity}%／風速 {wind} km/h",
          pingLoading: "正在測量延遲",
          pingUnavailable: "無法取得延遲",
          pingDetail: "服務商：{provider}",
          providerUnknown: "未知",
          searchPlaceholder: "搜尋模組…",
          weather: {
            clear: "晴朗",
            cloudy: "多雲",
            fog: "有霧",
            drizzle: "毛毛雨",
            rain: "下雨",
            snow: "下雪",
            storm: "雷雨"
          }
        },
        "zh-CN": {
          detecting: "正在检测位置",
          locationEstimate: "IP 估算／时区",
          locationUnavailable: "无法获取位置",
          locationDetail: "IP 估算／{timezone}",
          weatherLoading: "正在加载天气",
          weatherEstimate: "使用估算位置",
          weatherUnavailable: "无法获取天气",
          weatherDetail: "湿度 {humidity}%／风速 {wind} km/h",
          pingLoading: "正在测量延迟",
          pingUnavailable: "无法获取延迟",
          pingDetail: "服务商：{provider}",
          providerUnknown: "未知",
          searchPlaceholder: "搜索模块…",
          weather: {
            clear: "晴朗",
            cloudy: "多云",
            fog: "有雾",
            drizzle: "毛毛雨",
            rain: "下雨",
            snow: "下雪",
            storm: "雷雨"
          }
        }
      };

      const state = {
        language: ["en", "zh-TW", "zh-CN"].includes(document.documentElement.lang)
          ? document.documentElement.lang
          : "en",
        geo: null,
        weather: null,
        latency: null,
        locationFailed: false,
        weatherFailed: false,
        pingFailed: false
      };

      const nodes = {
        clock: document.querySelector("#home-clock"),
        date: document.querySelector("#home-date"),
        place: document.querySelector("#home-place"),
        placeMeta: document.querySelector("#home-place-meta"),
        weather: document.querySelector("#home-weather"),
        weatherMeta: document.querySelector("#home-weather-meta"),
        ping: document.querySelector("#home-ping"),
        pingMeta: document.querySelector("#home-ping-meta"),
        search: document.querySelector("#home-search-input")
      };

      const t = () => copy[state.language] || copy.en;
      const interpolate = (value, variables) =>
        Object.entries(variables).reduce(
          (result, [key, replacement]) => result.replace(`{${key}}`, String(replacement)),
          value
        );

      function updateClock() {
        const now = new Date();
        if (nodes.clock) {
          nodes.clock.textContent = new Intl.DateTimeFormat(state.language, {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false
          }).format(now);
        }
        if (nodes.date) {
          nodes.date.textContent = new Intl.DateTimeFormat(state.language, {
            year: "numeric",
            month: "long",
            day: "numeric",
            weekday: "short"
          }).format(now);
        }
      }

      function weatherLabel(code) {
        if (code === 0) return t().weather.clear;
        if ([1, 2, 3].includes(code)) return t().weather.cloudy;
        if ([45, 48].includes(code)) return t().weather.fog;
        if ([51, 53, 55, 56, 57].includes(code)) return t().weather.drizzle;
        if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return t().weather.rain;
        if ([71, 73, 75, 77, 85, 86].includes(code)) return t().weather.snow;
        if ([95, 96, 99].includes(code)) return t().weather.storm;
        return t().weather.cloudy;
      }

      function renderRuntime() {
        if (nodes.search) nodes.search.placeholder = t().searchPlaceholder;

        if (nodes.place && nodes.placeMeta) {
          if (state.geo) {
            const location = [
              state.geo.city,
              state.geo.region || state.geo.country_name
            ].filter(Boolean);
            nodes.place.textContent = location.join(", ") || state.geo.country_name || t().locationUnavailable;
            nodes.placeMeta.textContent = interpolate(t().locationDetail, {
              timezone: state.geo.timezone || "--"
            });
          } else {
            nodes.place.textContent = state.locationFailed
              ? t().locationUnavailable
              : t().detecting;
            nodes.placeMeta.textContent = t().locationEstimate;
          }
        }

        if (nodes.weather && nodes.weatherMeta) {
          if (state.weather) {
            nodes.weather.textContent = `${Math.round(state.weather.temperature)}°C / ${weatherLabel(state.weather.code)}`;
            nodes.weatherMeta.textContent = interpolate(t().weatherDetail, {
              humidity: state.weather.humidity ?? "--",
              wind: Math.round(state.weather.wind ?? 0)
            });
          } else {
            nodes.weather.textContent = state.weatherFailed
              ? t().weatherUnavailable
              : t().weatherLoading;
            nodes.weatherMeta.textContent = t().weatherEstimate;
          }
        }

        if (nodes.ping && nodes.pingMeta) {
          const provider =
            state.geo?.org || state.geo?.asn || t().providerUnknown;
          nodes.ping.textContent =
            state.latency !== null
              ? `${state.latency} ms`
              : state.pingFailed
                ? t().pingUnavailable
                : t().pingLoading;
          nodes.pingMeta.textContent =
            state.latency !== null || state.pingFailed
              ? interpolate(t().pingDetail, { provider })
              : "Cloudflare Pages";
        }
      }

      async function fetchJson(url, timeout = 5500) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeout);
        try {
          const response = await fetch(url, {
            signal: controller.signal,
            headers: { Accept: "application/json" }
          });
          if (!response.ok) throw new Error(`Request failed: ${response.status}`);
          return await response.json();
        } finally {
          clearTimeout(timer);
        }
      }

      async function loadLocationAndWeather() {
        try {
          const geo = await fetchJson("https://ipapi.co/json/");
          if (!geo.latitude || !geo.longitude) throw new Error("Location coordinates unavailable");
          state.geo = geo;
          renderRuntime();

          const params = new URLSearchParams({
            latitude: geo.latitude,
            longitude: geo.longitude,
            current: "temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m",
            timezone: "auto",
            forecast_days: "1"
          });
          const weather = await fetchJson(
            `https://api.open-meteo.com/v1/forecast?${params.toString()}`
          );
          state.weather = {
            temperature: weather.current?.temperature_2m,
            humidity: weather.current?.relative_humidity_2m,
            code: weather.current?.weather_code,
            wind: weather.current?.wind_speed_10m
          };
        } catch (error) {
          console.warn("Home runtime status:", error);
          if (!state.geo) state.locationFailed = true;
          state.weatherFailed = true;
        }
        renderRuntime();
      }

      async function measureLatency() {
        const samples = [];
        for (let index = 0; index < 3; index += 1) {
          try {
            const started = performance.now();
            const response = await fetch(`/robots.txt?ping=${Date.now()}-${index}`, {
              cache: "no-store",
              headers: { Accept: "text/plain" }
            });
            if (!response.ok) throw new Error(`Ping failed: ${response.status}`);
            await response.text();
            samples.push(performance.now() - started);
          } catch (error) {
            console.warn("Home latency:", error);
          }
        }

        if (samples.length) {
          state.latency = Math.round(
            samples.reduce((sum, value) => sum + value, 0) / samples.length
          );
        } else {
          state.pingFailed = true;
        }
        renderRuntime();
      }

      document.addEventListener("jats:language", (event) => {
        const nextLanguage = event.detail?.language;
        state.language = ["en", "zh-TW", "zh-CN"].includes(nextLanguage)
          ? nextLanguage
          : "en";
        updateClock();
        renderRuntime();
      });

      updateClock();
      renderRuntime();
      loadLocationAndWeather();
      measureLatency();
      setInterval(updateClock, 1000);
    })();
  </script>
</PortalLayout>
