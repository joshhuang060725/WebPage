---
import PortalLayout from "@layouts/PortalLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import Localized from "@components/Localized.astro";
import { readData } from "@lib/content";

const data = readData<any>("wallpapers.json");
const title = { en: "Wallpaper Surface", "zh-TW": "桌布介面", "zh-CN": "桌布界面" };
const description = {
  en: "A persistent browser start surface with selectable backgrounds and public shortcut tiles.",
  "zh-TW": "具背景選擇、公開捷徑與本機持久化的瀏覽器起始介面。",
  "zh-CN": "具背景选择、公开快捷方式与本地持久化的浏览器起始界面。"
};
---

<PortalLayout title={title} description={description} active="wallpapers">
  <PageHeader eyebrow={{ en: "SURFACE / LOCAL PREFERENCE", "zh-TW": "介面／本機偏好", "zh-CN": "界面／本地偏好" }} title={title} description={description} />
  <section class="wallpaper-stage panel" id="wallpaper-stage" tabindex="0" aria-label="Wallpaper preview">
    <div class="wallpaper-shade"></div>
    <div class="wallpaper-clock"><time id="wallpaper-time">--:--</time><span id="wallpaper-date">----</span></div>
    <form class="wallpaper-search" action="https://www.google.com/search" method="get" target="_blank">
      <label class="visually-hidden" for="web-search">Search the web</label>
      <input id="web-search" name="q" type="search" placeholder="Search the web…" autocomplete="off" />
      <button type="submit">↗</button>
    </form>
    <div class="shortcut-grid" id="shortcut-grid">
      {data.links.map((link: any, index: number) => (
        <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
          <span>{String(index + 1).padStart(2, "0")}</span>{link.label}
        </a>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">BACKGROUND PRESETS</p><h2><Localized value={{ en: "Choose a surface", "zh-TW": "選擇桌面背景", "zh-CN": "选择桌面背景" }} /></h2></div></div>
    <div class="wallpaper-list">
      {data.backgrounds.map((wallpaper: any) => (
        <button class="wallpaper-option" type="button" data-id={wallpaper.id} data-src={wallpaper.src}>
          <img src={wallpaper.src} alt="" loading="lazy" />
          <span><Localized value={wallpaper.title} /><small>{wallpaper.type || "image"}</small></span>
        </button>
      ))}
    </div>
  </section>
  <div id="wallpaper-status" class="notice" aria-live="polite">
    <Localized value={{ en: "Selection is stored only in this browser.", "zh-TW": "選擇只會保存在此瀏覽器。", "zh-CN": "选择只会保存在此浏览器。" }} />
  </div>

  <script is:inline slot="scripts">
    const stage = document.querySelector("#wallpaper-stage");
    const options = [...document.querySelectorAll(".wallpaper-option")];
    const time = document.querySelector("#wallpaper-time");
    const date = document.querySelector("#wallpaper-date");
    const applyWallpaper = (option) => {
      stage.style.backgroundImage = `url("${option.dataset.src}")`;
      options.forEach((item) => item.classList.toggle("is-active", item === option));
      localStorage.setItem("jats:wallpaper", option.dataset.id);
    };
    const selected = localStorage.getItem("jats:wallpaper");
    applyWallpaper(options.find((option) => option.dataset.id === selected) || options[0]);
    options.forEach((option) => option.addEventListener("click", () => applyWallpaper(option)));
    options.forEach((option) => option.querySelector("img")?.addEventListener("error", () => {
      option.classList.add("is-error");
      option.disabled = true;
    }));
    const updateClock = () => {
      const now = new Date();
      time.textContent = new Intl.DateTimeFormat(undefined, { hour: "2-digit", minute: "2-digit", hour12: false }).format(now);
      date.textContent = new Intl.DateTimeFormat(undefined, { weekday: "long", year: "numeric", month: "long", day: "numeric" }).format(now);
    };
    updateClock();
    setInterval(updateClock, 30000);
  </script>
</PortalLayout>

<style>
  .wallpaper-stage { min-height: 610px; padding: 2rem; display: flex; flex-direction: column; justify-content: center; background-position: center; background-size: cover; isolation: isolate; }
  .wallpaper-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(5,8,10,.82), rgba(5,8,10,.36)); }
  .wallpaper-clock { display: grid; color: white; text-shadow: 0 3px 16px #000; }
  .wallpaper-clock time { font: 900 clamp(4rem, 10vw, 8rem)/.9 ui-monospace, monospace; letter-spacing: -.08em; }
  .wallpaper-clock span { margin-top: .75rem; }
  .wallpaper-search { width: min(620px, 100%); margin: 2rem 0 1rem; display: grid; grid-template-columns: 1fr auto; }
  .wallpaper-search input { min-height: 52px; padding: .8rem 1rem; border: 1px solid rgba(255,255,255,.42); border-radius: 8px 0 0 8px; color: white; background: rgba(0,0,0,.48); }
  .wallpaper-search button { width: 52px; border-radius: 0 8px 8px 0; color: #111; background: var(--yellow); }
  .shortcut-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; }
  .shortcut-grid a { padding: .7rem; border: 1px solid rgba(255,255,255,.24); color: white; background: rgba(0,0,0,.42); text-decoration: none; backdrop-filter: blur(8px); }
  .shortcut-grid span { display: block; color: var(--yellow); font: 700 .6rem ui-monospace, monospace; }
  .wallpaper-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .wallpaper-option { padding: .5rem; text-align: left; }
  .wallpaper-option img { width: 100%; aspect-ratio: 16 / 10; display: block; object-fit: cover; border-radius: 5px; }
  .wallpaper-option > span { padding: .65rem .25rem .15rem; display: flex; justify-content: space-between; }
  .wallpaper-option small { color: var(--muted); }
  .wallpaper-option.is-active { border-color: var(--yellow); }
  .wallpaper-option.is-error { opacity: .45; }
  @media (max-width: 1000px) { .shortcut-grid { grid-template-columns: repeat(3, 1fr); } .wallpaper-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .wallpaper-stage { min-height: 560px; padding: 1rem; } .shortcut-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
