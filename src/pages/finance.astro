      const tabButtons = [...document.querySelectorAll("[data-finance-tab]")];
      const panes = [...document.querySelectorAll("[data-finance-pane]")];
      const mobileSelect = document.querySelector("#finance-view-select");
      let announceTimer = 0;
      let fxRequestId = 0;
      let fxRates = null;
      let fxMeta = null;

      function language() {
        return ["en", "zh-TW", "zh-CN"].includes(root.lang) ? root.lang : "en";
      }

      function text(value) {
        if (typeof value === "string") return value;
        return value?.[language()] || value?.en || "";
      }

      function announce(value) {
        if (!announcer) return;
        clearTimeout(announceTimer);
        announcer.textContent = text(value);
        announcer.hidden = false;
        announceTimer = window.setTimeout(() => {
          announcer.hidden = true;
        }, 4200);
      }

      function tabFromHash() {
        const raw = decodeURIComponent(location.hash.slice(1));
        const id = raw.startsWith("sources/") ? "sources" : raw;
        return validTabs.includes(id) ? id : "overview";
      }

      function activateTab(id, options = {}) {
        const next = validTabs.includes(id) ? id : "overview";
        tabButtons.forEach((button) => {
          const selected = button.dataset.financeTab === next;
          button.setAttribute("aria-selected", String(selected));
          button.tabIndex = selected ? 0 : -1;
        });
        panes.forEach((pane) => {
          pane.hidden = pane.dataset.financePane !== next;
        });
        if (mobileSelect) mobileSelect.value = next;

        if (options.updateHash !== false) {
          const hash = options.preserveSourceHash && location.hash.startsWith("#sources/")
            ? location.hash
            : `#${next}`;
          history.pushState(null, "", hash);
        }
        if (options.focus) {
          document.querySelector(`#finance-tab-${next}`)?.focus();
        }
        if (options.scroll) {
          document.querySelector(`#finance-pane-${next}`)?.scrollIntoView({ block: "start" });
        }
        if (config.regions?.[next] && localStorage.getItem(widgetConsentKey) === "granted") {
          loadWidget(next);
        }
        if (config.regions?.[next]) loadRegion(next);
        if (next === "fx" && !fxRates) loadFxRates();

        const sourceTarget = decodeURIComponent(location.hash.slice(1));
        if (next === "sources" && sourceTarget.startsWith("sources/")) {
          requestAnimationFrame(() => {
            document.getElementById(sourceTarget)?.scrollIntoView({ block: "center" });
          });
        }
      }

      tabButtons.forEach((button) => {
        button.addEventListener("click", () => activateTab(button.dataset.financeTab, { updateHash: true, scroll: true }));
        button.addEventListener("keydown", (event) => {
          const index = tabButtons.indexOf(button);
          let nextIndex = null;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabButtons.length;
          if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabButtons.length) % tabButtons.length;
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = tabButtons.length - 1;
          if (nextIndex === null) return;
          event.preventDefault();
          activateTab(tabButtons[nextIndex].dataset.financeTab, { updateHash: true, focus: true });
        });
      });

      document.querySelectorAll("[data-open-finance-tab]").forEach((link) => {
        link.addEventListener("click", (event) => {
          const id = link.dataset.openFinanceTab;
          if (!validTabs.includes(id)) return;
          event.preventDefault();
          const sourceHash = link.getAttribute("href")?.startsWith("#sources/") ? link.getAttribute("href") : null;
          if (sourceHash) history.pushState(null, "", sourceHash);
          activateTab(id, {
            updateHash: !sourceHash,
            preserveSourceHash: Boolean(sourceHash),
            scroll: true
          });
        });
      });

      mobileSelect?.addEventListener("change", () => activateTab(mobileSelect.value, { updateHash: true, scroll: true }));
      addEventListener("hashchange", () => activateTab(tabFromHash(), { updateHash: false, preserveSourceHash: true }));

      function updateClocks() {
        const now = new Date();
        Object.values(config.regions || {}).forEach((region) => {
          const locale = localeMap[language()];
          const time = new Intl.DateTimeFormat(locale, {
            timeZone: region.timezone,
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false
          }).format(now);
          const shortTime = new Intl.DateTimeFormat(locale, {
            timeZone: region.timezone,
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
          }).format(now);
          const date = new Intl.DateTimeFormat(locale, {
            timeZone: region.timezone,
            year: "numeric",
            month: "short",
            day: "2-digit",
            weekday: "short"
          }).format(now);
          document.querySelectorAll(`[data-region-time="${region.id}"]`).forEach((node) => (node.textContent = shortTime));
          document.querySelectorAll(`[data-region-clock="${region.id}"]`).forEach((node) => (node.textContent = time));
          document.querySelectorAll(`[data-region-date="${region.id}"]`).forEach((node) => (node.textContent = date));
        });
      }

      function renderWidgetGate(slot) {
        slot.classList.remove("is-loaded");
        slot.dataset.widgetState = "gated";
        slot.innerHTML = "";
        const gate = document.createElement("div");
        gate.className = "widget-gate";
        const icon = document.createElement("span");
        icon.className = "widget-gate-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = "EXT";
        const heading = document.createElement("h4");
        heading.textContent = text(config.copy.widgetTitle);
        const body = document.createElement("p");
        body.textContent = text(config.copy.widgetBody);
        const button = document.createElement("button");
        button.className = "button primary";
        button.type = "button";
        button.textContent = text(config.copy.widgetLoad);
        button.addEventListener("click", () => grantWidgetConsent(slot.dataset.widgetRegion));
        gate.append(icon, heading, body, button);
        slot.append(gate);
      }

      function widgetFallback(slot) {
        slot.classList.remove("is-loaded");
        slot.dataset.widgetState = "failed";
        slot.innerHTML = "";
        const fallback = document.createElement("div");
        fallback.className = "widget-fallback";
        fallback.textContent = text(config.copy.widgetFailed);
        slot.append(fallback);
      }

      function grantWidgetConsent(region) {
        localStorage.setItem(widgetConsentKey, "granted");
        announce(config.copy.consentGranted);
        loadWidget(region);
      }

      function loadWidget(region) {
        const slot = document.querySelector(`[data-widget-region="${region}"]`);
        if (!slot || slot.dataset.widgetState === "loading" || slot.dataset.widgetState === "loaded") return;
        if (localStorage.getItem(widgetConsentKey) !== "granted") {
          renderWidgetGate(slot);
          return;
        }

        slot.dataset.widgetState = "loading";
        slot.classList.add("is-loaded");
        slot.innerHTML = "";
        const container = document.createElement("div");
        container.className = "tradingview-widget-container";
        const widgetRoot = document.createElement("div");
        widgetRoot.className = "tradingview-widget-container__widget";
        container.append(widgetRoot);
        slot.append(container);

        const symbols = config.regions?.[region]?.widgetSymbols || [];
        const script = document.createElement("script");
        script.type = "text/javascript";
        script.src = "https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js";
        script.async = true;
        script.textContent = JSON.stringify({
          colorTheme: root.dataset.theme === "light" ? "light" : "dark",
          dateRange: "12M",
          showChart: true,
          locale: language() === "zh-TW" ? "zh_TW" : language() === "zh-CN" ? "zh_CN" : "en",
          isTransparent: true,
          showSymbolLogo: true,
          showFloatingTooltip: false,
          width: "100%",
          height: "348",
          tabs: [
            {
              title: text(config.regions[region].name),
              symbols: symbols.map((item) => ({ s: item.symbol, d: item.label }))
            }
          ]
        });
        container.append(script);

        const startedAt = Date.now();
        const check = window.setInterval(() => {
          if (slot.querySelector("iframe")) {
            clearInterval(check);
            slot.dataset.widgetState = "loaded";
          } else if (Date.now() - startedAt > 8000) {
            clearInterval(check);
            widgetFallback(slot);
          }
        }, 250);
      }

      document.querySelectorAll("[data-load-widget]").forEach((button) => {
        button.addEventListener("click", () => grantWidgetConsent(button.dataset.loadWidget));
      });

      document.querySelector("#revoke-widget-consent")?.addEventListener("click", () => {
        localStorage.removeItem(widgetConsentKey);
        document.querySelectorAll("[data-widget-region]").forEach(renderWidgetGate);
        announce(config.copy.consentRevoked);
      });

      function statusLabel(status) {
        return text(config.copy.statuses?.[status] || config.copy.statuses.unavailable);
      }

      function formatMetricValue(value, unit) {
        const number = Number(value);
        if (!Number.isFinite(number)) return "—";
        const digits = Math.abs(number) >= 1000 ? 0 : Math.abs(number) >= 10 ? 2 : 3;
        const formatted = new Intl.NumberFormat(localeMap[language()], {
          maximumFractionDigits: digits,
          minimumFractionDigits: unit === "percent" ? 2 : 0
        }).format(number);
        if (unit === "percent" || unit === "percent-year-on-year") return `${formatted}%`;
        return formatted;
      }

      function renderRegionItem(item) {
        if (!item?.id) return;
        const card = document.querySelector(`[data-indicator-card="${CSS.escape(item.id)}"]`);
        const row = document.querySelector(`[data-indicator-row="${CSS.escape(item.id)}"]`);
        const unit = item.unit || card?.dataset.unit || "";
        const formatted = formatMetricValue(item.value, unit);
        const status = item.status || "partial";
        if (card) {
          card.dataset.state = status;
          const value = card.querySelector('[data-role="value"]');
          const statusNode = card.querySelector('[data-role="status"]');
          const asOf = card.querySelector('[data-role="asof"]');
          if (value) value.textContent = formatted;
          if (statusNode) {
            statusNode.dataset.state = status;
            statusNode.textContent = statusLabel(status);
          }
          if (asOf) asOf.textContent = `${text(config.copy.asOf)}: ${item.asOf || "—"}`;
        }
        if (row) {
          const value = row.querySelector('[data-role="table-value"]');
          if (value) value.textContent = formatted;
        }
      }

      const regionLoads = new Map();
      async function loadRegion(region, force = false) {
        if (!config.regions?.[region]) return;
        if (!force && regionLoads.has(region)) return regionLoads.get(region);
        const statusNode = document.querySelector(`[data-region-status="${region}"]`);
        if (statusNode) {
          statusNode.dataset.state = "partial";
          statusNode.textContent = text(config.copy.loading);
        }
        const task = (async () => {
          try {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 8000);
            const response = await fetch(`/api/finance/regions/${region}`, {
              headers: { Accept: "application/json" },
              signal: controller.signal
            });
            clearTimeout(timer);
            if (!response.ok) throw new Error("region_unavailable");
            const payload = await response.json();
            const items = payload?.data?.items || payload?.data?.snapshot?.items || [];
            items.forEach(renderRegionItem);
            const state = items.length ? (payload?.data?.status || "partial") : "unavailable";
            if (statusNode) {
              statusNode.dataset.state = state;
              statusNode.textContent = statusLabel(state);
            }
            return true;
          } catch {
            if (statusNode) {
              statusNode.dataset.state = "unavailable";
              statusNode.textContent = statusLabel("unavailable");
            }
            return false;
          }
        })();
        regionLoads.set(region, task);
        return task;
      }

      document.querySelectorAll("[data-region-refresh]").forEach((button) => {
        button.addEventListener("click", async () => {
          regionLoads.delete(button.dataset.regionRefresh);
          const refreshed = await loadRegion(button.dataset.regionRefresh, true);
          announce(refreshed ? config.copy.refreshed : config.copy.refreshFailed);
        });
      });

      function validRate(value) {
        return Number.isFinite(Number(value)) && Number(value) > 0;
      }

      function normalizeApiQuotes(payload) {
        const rates = { USD: 1 };
        const quoteMeta = {};
        const quoteRows = payload?.data?.quotes || [];
        quoteRows.forEach((row) => {
          if (config.currencies.includes(row.currency) && validRate(row.rate)) {
            rates[row.currency] = Number(row.rate);
            quoteMeta[row.currency] = {
              provider: row.provider || null,
              asOf: row.asOf || null
            };
          }
        });
        return {
          rates,
          quoteMeta,
          asOf: payload?.meta?.asOf || quoteRows.find((row) => row.asOf)?.asOf || null,
          sources: payload?.meta?.sources || []
        };
      }

      function normalizeFrankfurterRows(payload) {
        const rows = Array.isArray(payload) ? payload : [];
        const rates = { USD: 1 };
        const quoteMeta = {};
        let asOf = null;
        rows.forEach((row) => {
          if (row?.base === "USD" && config.currencies.includes(row.quote) && validRate(row.rate)) {
            rates[row.quote] = Number(row.rate);
            quoteMeta[row.quote] = {
              provider: "frankfurter",
              asOf: row.date || null
            };
            asOf ||= row.date || null;
          }
        });
        return {
          rates,
          quoteMeta,
          asOf,
          sources: [{ id: "frankfurter", name: "Frankfurter", url: "https://frankfurter.dev/" }]
        };
      }

      function normalizeFawaz(payload) {
        const rates = { USD: 1 };
        const quoteMeta = {};
        Object.entries(payload?.usd || {}).forEach(([code, value]) => {
          const normalized = code.toUpperCase();
          if (config.currencies.includes(normalized) && validRate(value)) {
            rates[normalized] = Number(value);
            quoteMeta[normalized] = {
              provider: "fawaz-currency-api",
              asOf: payload?.date || null
            };
          }
        });
        return {
          rates,
          quoteMeta,
          asOf: payload?.date || null,
          sources: [{ id: "fawaz-currency-api", name: "Fawaz Currency API", url: "https://github.com/fawazahmed0/exchange-api" }]
        };
      }

      async function fetchJson(url, timeoutMs = 8000) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeoutMs);
        try {
          const response = await fetch(url, { headers: { Accept: "application/json" }, signal: controller.signal });
          if (!response.ok) throw new Error("request_failed");
          return await response.json();
        } finally {
          clearTimeout(timer);
        }
      }

      function readFxCache() {
        try {
          const cached = financeLogic.readFinanceCache(
            localStorage.getItem(fxCacheKey),
            fxCacheKey
          );
          if (!cached.envelope?.data?.rates) return null;
          return {
            ...cached.envelope.data,
            cacheState: cached.state === "stale" ? "stale" : "cached"
          };
        } catch {
          return null;
        }
      }

      function storeFxCache(data) {
        try {
          const cached = financeLogic.createFinanceCache(fxCacheKey, data, {
            freshForMs: 86400000,
            staleForMs: 7 * 86400000
          });
          localStorage.setItem(fxCacheKey, JSON.stringify(cached));
        } catch {}
      }

      async function loadFxRates(force = false) {
        const requestId = ++fxRequestId;
        const sourceNode = document.querySelector("#fx-source");
        if (sourceNode) sourceNode.textContent = text(config.copy.loading);
        if (!force) {
          const cached = readFxCache();
          if (cached) {
            fxRates = cached.rates;
            fxMeta = cached;
            renderFx();
            if (sourceNode) sourceNode.textContent = text(cached.cacheState === "stale" ? config.copy.stale : config.copy.cached);
          }
        }

        const quotes = config.currencies.filter((code) => code !== "USD");
        let collected = { rates: { USD: 1 }, quoteMeta: {}, asOf: null, sources: [] };
        const localHost = location.hostname === "127.0.0.1" || location.hostname === "localhost";
        if (!localHost || window.__JATS_TEST_FINANCE_API__ === true) {
          try {
            const apiPayload = await fetchJson(`/api/finance/fx?base=USD&symbols=${regionalCurrencies.filter((code) => code !== "USD").join(",")}`);
            collected = normalizeApiQuotes(apiPayload);
          } catch {}
        }

        const missing = quotes.filter((code) => !validRate(collected.rates[code]));
        if (missing.length) {
          try {
            const payload = await fetchJson(`https://api.frankfurter.dev/v2/rates?base=USD&quotes=${encodeURIComponent(missing.join(","))}`);
            const normalized = normalizeFrankfurterRows(payload);
            collected.rates = { ...collected.rates, ...normalized.rates };
            collected.quoteMeta = { ...collected.quoteMeta, ...normalized.quoteMeta };
            collected.asOf ||= normalized.asOf;
            collected.sources = [...collected.sources, ...normalized.sources];
          } catch {}
        }

        const stillMissing = quotes.filter((code) => !validRate(collected.rates[code]));
        if (stillMissing.length) {
          try {
            const payload = await fetchJson("https://latest.currency-api.pages.dev/v1/currencies/usd.json");
            const normalized = normalizeFawaz(payload);
            stillMissing.forEach((code) => {
              if (validRate(normalized.rates[code])) {
                collected.rates[code] = normalized.rates[code];
                collected.quoteMeta[code] = normalized.quoteMeta[code];
              }
            });
            collected.asOf ||= normalized.asOf;
            collected.sources = [...collected.sources, ...normalized.sources];
          } catch {}
        }

        if (requestId !== fxRequestId) return false;
        if (Object.keys(collected.rates).length < 2) {
          if (fxRates) {
            renderFx();
            renderOverviewFx();
          } else {
            if (sourceNode) sourceNode.textContent = text(config.copy.ratesUnavailable);
            document.querySelector("#fx-result").textContent = text(config.copy.ratesUnavailable);
          }
          return false;
        }

        const uniqueSources = [...new Map(collected.sources.map((source) => [source.id, source])).values()];
        fxRates = collected.rates;
        fxMeta = {
          asOf: collected.asOf,
          sources: uniqueSources,
          quoteMeta: collected.quoteMeta,
          fetchedAt: new Date().toISOString()
        };
        storeFxCache({ rates: fxRates, ...fxMeta });
        renderFx();
        renderOverviewFx();
        return true;
      }

      const fx = {
        amount: document.querySelector("#fx-amount"),
        precision: document.querySelector("#fx-precision"),
        from: document.querySelector("#fx-from"),
        to: document.querySelector("#fx-to"),
        result: document.querySelector("#fx-result"),
        rate: document.querySelector("#fx-rate"),
        source: document.querySelector("#fx-source"),
        sourceLink: document.querySelector("#fx-source-link"),
        feePercent: document.querySelector("#fx-fee-percent"),
        fixedFee: document.querySelector("#fx-fixed-fee"),
        quotedRate: document.querySelector("#fx-quoted-rate"),
        costError: document.querySelector("#fx-cost-error"),
        received: document.querySelector("#fx-cost-received"),
        difference: document.querySelector("#fx-cost-difference"),
        effective: document.querySelector("#fx-effective-rate"),
        costPercent: document.querySelector("#fx-cost-percent")
      };

      function readFxPrefs() {
        try {
          const prefs = JSON.parse(localStorage.getItem(fxPrefsKey) || "null");
          if (prefs?.version !== 1) return { from: "USD", to: "TWD", precision: "4" };
          return {
            from: config.currencies.includes(prefs.from) ? prefs.from : "USD",
            to: config.currencies.includes(prefs.to) ? prefs.to : "TWD",
            precision: ["2", "4", "6"].includes(prefs.precision) ? prefs.precision : "4"
          };
        } catch {
          return { from: "USD", to: "TWD", precision: "4" };
        }
      }

      function saveFxPrefs() {
        try {
          localStorage.setItem(fxPrefsKey, JSON.stringify({
            version: 1,
            from: fx.from.value,
            to: fx.to.value,
            precision: fx.precision.value
          }));
        } catch {}
      }

      function populateCurrencies() {
        const currentFrom = fx.from.value;
        const currentTo = fx.to.value;
        [fx.from, fx.to].forEach((select) => {
          select.innerHTML = "";
          config.currencies.forEach((code) => {
            const option = document.createElement("option");
            option.value = code;
            option.textContent = `${code} — ${text(config.copy.currencyNames[code])}`;
            select.append(option);
          });
        });
        const prefs = readFxPrefs();
        fx.from.value = config.currencies.includes(currentFrom) ? currentFrom : prefs.from;
        fx.to.value = config.currencies.includes(currentTo) ? currentTo : prefs.to;
        fx.precision.value = prefs.precision;
      }

      function rateBetween(base, quote) {
        try {
          return financeLogic.crossRate(fxRates || {}, base, quote);
        } catch {
          return null;
        }
      }

      function numberFormat(value, digits = 4) {
        return new Intl.NumberFormat(localeMap[language()], {
          minimumFractionDigits: Math.min(2, digits),
          maximumFractionDigits: digits
        }).format(value);
      }

      function pairReferenceMeta(base, quote) {
        const sourceById = new Map((fxMeta?.sources || []).map((source) => [source.id, source]));
        const details = [...new Set([base, quote])]
          .filter((currency) => currency !== "USD")
          .map((currency) => fxMeta?.quoteMeta?.[currency])
          .filter(Boolean);
        const providerIds = [...new Set(details.map((detail) => detail.provider).filter(Boolean))];
        const sources = providerIds.map((id) => sourceById.get(id)).filter(Boolean);
        const dates = [...new Set(details.map((detail) => detail.asOf).filter(Boolean))].sort();
        return {
          sources: sources.length ? sources : fxMeta?.sources || [],
          dates: dates.length ? dates : [fxMeta?.asOf].filter(Boolean)
        };
      }

      function sourceDisplayName(source) {
        return text(config.sources?.[source?.id]?.name) || source?.name || source?.id || "";
      }

      function fxFreshness(dates) {
        if (fxMeta?.cacheState === "stale") return "stale";
        if (fxMeta?.cacheState === "cached") return "cached";
        const oldest = [...dates].sort().at(0) || null;
        return financeLogic.freshnessStatus(oldest, "business-daily");
      }

      function setInvalid(node, invalid) {
        if (!node) return;
        if (invalid) node.setAttribute("aria-invalid", "true");
        else node.removeAttribute("aria-invalid");
      }

      function clearCostResults() {
        [fx.received, fx.difference, fx.effective, fx.costPercent].forEach(
          (node) => (node.textContent = "—")
        );
      }

      function renderFx() {
        if (!fxRates) return;
        const amount = Number(fx.amount.value);
        const digits = Number(fx.precision.value);
        const rate = rateBetween(fx.from.value, fx.to.value);
        const invalidAmount = !Number.isFinite(amount) || amount < 0 || !rate;
        setInvalid(fx.amount, invalidAmount);
        if (invalidAmount) {
          fx.result.textContent = text(config.copy.invalidAmount);
          fx.rate.textContent = "—";
          clearCostResults();
          fx.costError.hidden = true;
          fx.costError.textContent = "";
          return;
        }

        const converted = amount * rate;
        fx.result.textContent = `${numberFormat(converted, digits)} ${fx.to.value}`;
        fx.rate.textContent = `1 ${fx.from.value} = ${numberFormat(rate, Math.max(4, digits))} ${fx.to.value}`;
        const pairMeta = pairReferenceMeta(fx.from.value, fx.to.value);
        const sourceNames =
          pairMeta.sources.map(sourceDisplayName).filter(Boolean).join(" + ") ||
          text(config.copy.source);
        const dateLabel = pairMeta.dates.join(" / ") || "—";
        fx.source.textContent = `${sourceNames} · ${text(config.copy.asOf)}: ${dateLabel}`;
        if (fx.sourceLink) {
          fx.sourceLink.href =
            pairMeta.sources.length === 1
              ? `#sources/${pairMeta.sources[0].id}`
              : "#sources";
        }

        const percentFee = Number(fx.feePercent.value || 0);
        const fixedFee = Number(fx.fixedFee.value || 0);
        const quotedRate = Number(fx.quotedRate.value || rate);
        const invalidPercent =
          !Number.isFinite(percentFee) || percentFee < 0 || percentFee > 100;
        const invalidFixed = !Number.isFinite(fixedFee) || fixedFee < 0;
        const invalidQuote = !validRate(quotedRate);
        setInvalid(fx.feePercent, invalidPercent);
        setInvalid(fx.fixedFee, invalidFixed);
        setInvalid(fx.quotedRate, invalidQuote);
        if (invalidPercent || invalidFixed || invalidQuote) {
          clearCostResults();
          fx.costError.textContent = text(config.copy.invalidCostInputs);
          fx.costError.hidden = false;
          return;
        }
        fx.costError.hidden = true;
        fx.costError.textContent = "";
        const cost = financeLogic.calculateFxCost({
          amount,
          referenceRate: rate,
          feePercent: percentFee,
          fixedFee,
          quotedRate
        });
        fx.received.textContent = `${numberFormat(cost.received, digits)} ${fx.to.value}`;
        fx.difference.textContent = `${numberFormat(cost.totalCostInQuoteCurrency, digits)} ${fx.to.value}`;
        fx.effective.textContent = numberFormat(cost.effectiveRate, Math.max(4, digits));
        fx.costPercent.textContent = `${numberFormat(cost.costPercent, 2)}%`;
        saveFxPrefs();
      }

      function renderOverviewFx() {
        if (!fxRates) return;
        document.querySelectorAll("[data-overview-fx-value]").forEach((valueNode) => {
          const pair = valueNode.dataset.overviewFxValue;
          const [base, quote] = pair.split("/");
          const rate = rateBetween(base, quote);
          if (!rate) return;
          valueNode.textContent = numberFormat(rate, 4);
          const pairMeta = pairReferenceMeta(base, quote);
          const state = fxFreshness(pairMeta.dates);
          const card = valueNode.closest(".metric-card");
          if (card) card.dataset.state = state;
          const status = document.querySelector(`[data-overview-fx-status="${pair}"]`);
          const meta = document.querySelector(`[data-overview-fx-meta="${pair}"]`);
          const asOf = document.querySelector(`[data-overview-fx-asof="${pair}"]`);
          const sourceLink = document.querySelector(`[data-overview-fx-source="${pair}"]`);
          if (status) {
            status.dataset.state = state;
            status.textContent = statusLabel(state);
          }
          if (meta) {
            meta.textContent =
              pairMeta.sources.map(sourceDisplayName).filter(Boolean).join(" + ") ||
              text(config.copy.source);
          }
          if (asOf) {
            asOf.textContent = `${text(config.copy.asOf)}: ${pairMeta.dates.join(" / ") || "—"}`;
          }
          if (sourceLink) {
            sourceLink.href =
              pairMeta.sources.length === 1
                ? `#sources/${pairMeta.sources[0].id}`
                : "#sources";
          }
        });
      }

      [fx.amount, fx.feePercent, fx.fixedFee, fx.quotedRate].forEach((node) => node?.addEventListener("input", renderFx));
      [fx.precision, fx.from, fx.to].forEach((node) => node?.addEventListener("change", renderFx));
      document.querySelector("#fx-swap")?.addEventListener("click", () => {
        [fx.from.value, fx.to.value] = [fx.to.value, fx.from.value];
        renderFx();
      });
      document.querySelector("#fx-refresh")?.addEventListener("click", async () => {
        const refreshed = await loadFxRates(true);
        announce(refreshed ? config.copy.refreshed : config.copy.refreshFailed);
      });

      document.querySelector("#source-region-filter")?.addEventListener("change", (event) => {
        const selected = event.currentTarget.value;
        document.querySelectorAll("[data-source-region]").forEach((row) => {
          row.hidden = selected !== "all" && row.dataset.sourceRegion !== selected;
        });
      });

      document.addEventListener("jats:language", () => {
        populateCurrencies();
        updateClocks();
        renderFx();
        renderOverviewFx();
        document.querySelectorAll('[data-widget-state="gated"]').forEach(renderWidgetGate);
      });

      const themeObserver = new MutationObserver(() => {
        if (localStorage.getItem(widgetConsentKey) !== "granted") return;
        document.querySelectorAll("[data-widget-region]").forEach((slot) => {
          if (slot.dataset.widgetState === "loaded" || slot.dataset.widgetState === "failed") {
            slot.dataset.widgetState = "";
            loadWidget(slot.dataset.widgetRegion);
          }
        });
      });
      themeObserver.observe(root, { attributes: true, attributeFilter: ["data-theme"] });

      populateCurrencies();
      updateClocks();
      setInterval(updateClocks, 30000);
      activateTab(tabFromHash(), { updateHash: false, preserveSourceHash: true });
      loadFxRates();
      };
      if (window.JATSFinance) initializeFinance();
      else window.addEventListener("jats:finance-runtime-ready", initializeFinance, { once: true });
    })();
  </script>
</PortalLayout>
