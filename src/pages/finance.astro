---
import PortalLayout from "@layouts/PortalLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import Localized from "@components/Localized.astro";
import StatusBadge from "@components/StatusBadge.astro";
import FinanceRuntime from "@components/FinanceRuntime.astro";
import { readData, type Localized as LocalizedValue } from "@lib/content";
import "../styles/finance.css";

const finance = readData<any>("finance.json");
const regionIds = ["us", "hk", "cn", "tw", "sg"] as const;
const regions = regionIds.map((id) => finance[id]);
const sourceMap = new Map(finance.sources.map((source: any) => [source.id, source]));
const l = (en: string, zhTW: string, zhCN: string): LocalizedValue => ({
  en,
  "zh-TW": zhTW,
  "zh-CN": zhCN
});

const title = l("Regional Finance Terminal", "區域金融終端", "区域金融终端");
const description = l(
  "A source-first macro and market reference for the United States, Hong Kong, Mainland China, Taiwan, and Singapore.",
  "以來源透明為核心，聚焦美國、香港、中國大陸、臺灣與新加坡的總體經濟與市場參考終端。",
  "以来源透明为核心，聚焦美国、香港、中国大陆、台湾与新加坡的宏观经济与市场参考终端。"
);

const ui = {
  eyebrow: l("FINANCE / REGIONAL MACRO", "金融／區域總體經濟", "金融／区域宏观经济"),
  reviewed: l("Source registry reviewed", "來源清單已檢視", "来源清单已检查"),
  dataStatus: l("Data health: source-first", "資料健康：來源優先", "数据健康：来源优先"),
  delayedOnly: l("Delayed reference only", "僅供延遲參考", "仅供延迟参考"),
  tabs: {
    overview: l("Overview", "總覽", "总览"),
    us: finance.us.name,
    hk: finance.hk.name,
    cn: finance.cn.name,
    tw: finance.tw.name,
    sg: finance.sg.name,
    fx: l("FX Lab", "匯率實驗室", "汇率实验室"),
