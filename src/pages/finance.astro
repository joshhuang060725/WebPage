  effectiveRate: l("Effective rate", "有效匯率", "有效汇率"),
  costPercent: l("Cost ratio", "成本比例", "成本比例"),
  methodTitle: l("Data modes", "資料接入模式", "数据接入模式"),
  methodBody: l(
    "The interface labels how each number reaches the page. These modes are not interchangeable.",
    "介面會標示每個數值如何抵達頁面；不同接入模式不可混為一談。",
    "界面会标示每个数值如何到达页面；不同接入模式不可混为一谈。"
  ),
  sourcesTitle: l("Sources & methodology", "資料來源與方法", "数据来源与方法"),
  sourcesDescription: l(
    "The final page is the canonical registry for metric definitions, access methods, update cadence, and official links.",
    "最後一頁是指標定義、接入方式、更新頻率與官方連結的正式清單。",
    "最后一页是指标定义、接入方式、更新频率与官方链接的正式清单。"
  ),
  filterRegion: l("Filter by region", "依地區篩選", "按地区筛选"),
  allRegions: l("All regions", "所有地區", "所有地区"),
  publisher: l("Publisher", "發布機構", "发布机构"),
  region: l("Region", "地區", "地区"),
  access: l("Access", "接入方式", "接入方式"),
