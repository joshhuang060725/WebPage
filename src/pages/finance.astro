  source: l("Source", "來源", "来源"),
  asOf: l("As of", "資料日期", "数据日期"),
  cadence: l("Cadence", "更新頻率", "更新频率"),
  metric: l("Metric", "指標", "指标"),
  value: l("Value", "數值", "数值"),
  status: l("Status", "狀態", "状态"),
  currentView: l("Current view", "目前視圖", "当前视图"),
  moduleStatus: l("Finance module status", "金融模組狀態", "金融模块状态"),
  financeViews: l("Finance views", "金融視圖", "金融视图"),
