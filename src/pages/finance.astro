const clientConfig = {
  regions: Object.fromEntries(
    regions.map((region: any) => [
      region.id,
      {
        id: region.id,
        name: region.name,
        currency: region.currency,
        timezone: region.timezone,
        widgetSymbols: regionWidgetSymbols[region.id]
      }
    ])
  ),
  sources: Object.fromEntries(
    finance.sources.map((source: any) => [
      source.id,
      { id: source.id, name: source.name, url: source.url }
    ])
  ),
  currencies: finance.fx.supportedCurrencies.map((currency: any) => currency.code),
  copy: clientCopy
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title.en,
  description: description.en,
  url: "https://joshhuang.ccwu.cc/finance.html",
  about: regions.map((region: any) => ({
    "@type": "Place",
    name: region.name.en
  })),
  isPartOf: {
    "@type": "WebSite",
    name: "JATSWeb",
    url: "https://joshhuang.ccwu.cc"
  }
};
---

<PortalLayout title={title} description={description} active="finance" canonical="/finance.html">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://api.frankfurter.dev" />

  <div class="finance-terminal">
    <PageHeader eyebrow={ui.eyebrow} title={title} description={description} />

    <div class="finance-topline" role="region" aria-labelledby="finance-module-status-label">
      <span id="finance-module-status-label" class="visually-hidden"><Localized value={ui.moduleStatus} /></span>
      <StatusBadge status="beta" />
      <span class="tag"><span class="finance-health-dot" aria-hidden="true"></span><Localized value={ui.dataStatus} /></span>
      <span class="tag"><Localized value={ui.reviewed} /> · {finance.lastReviewedAt}</span>
      <span class="tag"><Localized value={ui.delayedOnly} /></span>
    </div>

    <nav class="finance-tabs-shell" aria-labelledby="finance-views-label">
      <span id="finance-views-label" class="visually-hidden"><Localized value={ui.financeViews} /></span>
