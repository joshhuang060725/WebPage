  accountBoundary: l("Account boundary", "帳號邊界", "账号边界"),
  localOnly: l("No account · local preferences", "無帳號 · 偏好留在本機", "无账号 · 偏好留在本机"),
  marketBoundary: l("Market-data boundary", "行情資料邊界", "行情数据边界"),
