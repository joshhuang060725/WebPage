---
import Localized from "@components/Localized.astro";
import Icon from "@components/Icon.astro";
import "../styles/global.css";
import type { Localized as LocalizedValue } from "@lib/content";

interface Props {
  title: LocalizedValue;
  description: LocalizedValue;
  canonical?: string;
  active?: string;
}

const { title, description, canonical = Astro.url.pathname, active = "" } = Astro.props;
const base = "https://joshhuang.ccwu.cc";
const nav = [
  { id: "portal", href: "/", icon: "home", label: { en: "Portal", "zh-TW": "主頁", "zh-CN": "主页" } },
  { id: "profile", href: "/profile.html", icon: "profile", label: { en: "Bio", "zh-TW": "個人資料", "zh-CN": "个人资料" } },
  { id: "wallpapers", href: "/wallpapers.html", icon: "wallpaper", label: { en: "Wallpapers", "zh-TW": "桌布", "zh-CN": "壁纸" } },
  { id: "projects", href: "/projects.html", icon: "projects", label: { en: "Projects", "zh-TW": "專案", "zh-CN": "项目" } },
  { id: "formulas", href: "/formulas.html", icon: "formula", label: { en: "Formula Lab", "zh-TW": "公式實驗室", "zh-CN": "公式实验室" } },
  { id: "links", href: "/links.html", icon: "links", label: { en: "Quick Links", "zh-TW": "快速連結", "zh-CN": "快速链接" } },
  { id: "youtube", href: "/youtube.html", icon: "youtube", label: { en: "YouTube", "zh-TW": "影片搜尋", "zh-CN": "视频搜索" } },
  { id: "finance", href: "/finance.html", icon: "finance", label: { en: "Finance", "zh-TW": "金融終端", "zh-CN": "金融终端" } },
  { id: "tools", href: "/tools.html", icon: "tools", label: { en: "Tools", "zh-TW": "工具", "zh-CN": "工具" } },
  { id: "files", href: "/files.html", icon: "files", label: { en: "Files", "zh-TW": "檔案", "zh-CN": "文件" } }
] as const;
const portalIsActive = !active || active === "portal";
const brandSystem = {
  en: "Personal Portal",
  "zh-TW": "個人入口",
  "zh-CN": "个人入口"
};
const staticBuild = {
  en: "Static build",
  "zh-TW": "靜態版本",
  "zh-CN": "静态版本"
};
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "JATSWeb",
  url: base,
  author: { "@type": "Person", name: "Josh Huang" },
  inLanguage: ["en", "zh-TW", "zh-CN"]
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.en} | JATSWeb</title>
    <meta name="description" content={description.en} />
    <meta name="theme-color" content="#0a0d10" />
    <link rel="canonical" href={new URL(canonical, base)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JATSWeb" />
    <meta property="og:title" content={`${title.en} | JATSWeb`} />
    <meta property="og:description" content={description.en} />
    <meta property="og:url" content={new URL(canonical, base)} />
    <meta property="og:image" content={`${base}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let legacyLanguage = null;
        let currentLanguage = null;
        let legacyTheme = null;
        let currentTheme = null;
        try {
          legacyLanguage = localStorage.getItem("portal-lang");
          currentLanguage = localStorage.getItem("jats:language");
          legacyTheme = localStorage.getItem("portal-theme");
          currentTheme = localStorage.getItem("jats:theme");
        } catch {}
        const detected = navigator.language.toLowerCase();
        const initial =
          legacyLanguage ||
          currentLanguage ||
          (detected.startsWith("zh-tw") || detected.startsWith("zh-hk") || detected.startsWith("zh-mo")
            ? "zh-TW"
            : detected.startsWith("zh")
              ? "zh-CN"
              : "en");
        const initialThemeMode = ["auto", "light", "dark"].includes(legacyTheme)
          ? legacyTheme
          : ["light", "dark"].includes(currentTheme)
            ? currentTheme
            : "auto";
        const hour = new Date().getHours();
        const resolvedTheme =
          initialThemeMode === "auto"
            ? hour >= 7 && hour < 18
              ? "light"
              : "dark"
            : initialThemeMode;
        root.lang = initial;
        root.dataset.initialLanguage = initial;
        root.dataset.initialThemeMode = initialThemeMode;
        root.dataset.themeMode = initialThemeMode;
        root.dataset.theme = resolvedTheme;
        if (initial !== "en") root.dataset.languagePending = "true";
      })();
    </script>
    <style is:inline>
      html[data-language-pending="true"] body { visibility: hidden; }
    </style>
    <noscript><style>body { visibility: visible !important; }</style></noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <aside
        id="primary-navigation"
        class="side-nav"
        aria-label="Primary navigation"
        data-nav-collapsible
        tabindex="0"
      >
        <a class="brand" href="/" aria-label="Josh Huang portal home">
          <span class="brand-mark">J</span>
          <span class="brand-copy">
            <strong>JOSH</strong>
            <Localized value={brandSystem} tag="small" />
          </span>
        </a>
        <nav class="nav-links">
          {
            nav.map((item, index) => {
              const current = item.id === "portal" ? portalIsActive : active === item.id;
              return (
                <a
                  class:list={["nav-link", current && "is-active"]}
                  href={item.href}
                  aria-current={current ? "page" : undefined}
                  title={item.label.en}
                >
                  <span class="nav-icon"><Icon name={item.icon} size={19} /></span>
                  <span class="nav-label"><Localized value={item.label} /></span>
                  <span class="nav-index" aria-hidden="true">{String(index).padStart(2, "0")}</span>
                </a>
              );
            })
          }
        </nav>
        <div class="nav-preferences">
          <div class="language-panel" aria-label="Language selector">
            <button type="button" data-lang="en" aria-label="English">EN</button>
            <button type="button" data-lang="zh-TW" aria-label="繁體中文">繁</button>
            <button type="button" data-lang="zh-CN" aria-label="简体中文">简</button>
          </div>
          <div class="theme-panel" aria-label="Theme selector">
            <button type="button" data-theme-mode="auto">
              <Icon name="auto" size={14} />
              <span>AUTO</span>
            </button>
            <button type="button" data-theme-mode="light">
              <Icon name="sun" size={14} />
              <span>DAY</span>
            </button>
            <button type="button" data-theme-mode="dark">
              <Icon name="moon" size={14} />
              <span>NIGHT</span>
            </button>
          </div>
        </div>
        <p class="nav-meta">
          <Localized value={staticBuild} tag="span" />
          <strong id="last-modified">--</strong>
          <small>JATSWeb v2.0</small>
        </p>
      </aside>

      <header class="mobile-header">
        <a class="mobile-brand" href="/" aria-label="Josh Huang portal home">
          <span class="brand-mark">J</span>
          <span>JOSH</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-label="Open navigation"
          aria-controls="primary-navigation"
          aria-expanded="false"
        >
          <Icon name="menu" size={20} class="nav-toggle-menu" />
          <Icon name="close" size={20} class="nav-toggle-close" />
        </button>
      </header>

      <main id="main" class="main-content">
        <slot />
      </main>

      <button class="nav-scrim" type="button" aria-label="Close navigation" tabindex="-1"></button>
    </div>

    <footer class="site-footer">
      <span>JATSWeb / Josh Huang</span>
      <span>Static-first · Public read-only · v2.0</span>
    </footer>

    <script>
      // @ts-nocheck
      const root = document.documentElement;
      const body = document.body;
      const navRail = document.querySelector("#primary-navigation");
      const navToggle = document.querySelector(".nav-toggle");
      const navScrim = document.querySelector(".nav-scrim");
      const mobileNavQuery = matchMedia("(max-width: 1020px)");
      let language = root.dataset.initialLanguage || "en";
      let themeMode = root.dataset.initialThemeMode || "auto";
      let lastNavFocus = null;

      function storePreference(key, value) {
        try {
          localStorage.setItem(key, value);
        } catch {}
      }

      function renderLastModified() {
        const node = document.querySelector("#last-modified");
        if (!node) return;
        const parsed = new Date(document.lastModified);
        node.textContent = Number.isFinite(parsed.getTime())
          ? new Intl.DateTimeFormat(language, {
              year: "numeric",
              month: "2-digit",
              day: "2-digit"
            }).format(parsed)
          : "--";
      }

      function applyLanguage(nextLanguage) {
        language = ["en", "zh-TW", "zh-CN"].includes(nextLanguage) ? nextLanguage : "en";
        storePreference("portal-lang", language);
        storePreference("jats:language", language);
        root.lang = language;
        document.querySelectorAll("[data-localized]").forEach((node) => {
          const key = language === "zh-TW" ? "zhTw" : language === "zh-CN" ? "zhCn" : "en";
          const value = node.dataset[key] || node.dataset.en || "";
          if (node.dataset.localizedHtml === "true") node.innerHTML = value;
          else node.textContent = value;
        });
        document.querySelectorAll("[data-lang]").forEach((button) => {
          button.classList.toggle("is-active", button.dataset.lang === language);
          button.setAttribute("aria-pressed", String(button.dataset.lang === language));
        });
        renderLastModified();
        document.dispatchEvent(new CustomEvent("jats:language", { detail: { language } }));
      }

      document.querySelectorAll("[data-lang]").forEach((button) => {
        button.addEventListener("click", () => applyLanguage(button.dataset.lang));
      });

      function resolveTheme(mode) {
        if (mode !== "auto") return mode;
        const hour = new Date().getHours();
        return hour >= 7 && hour < 18 ? "light" : "dark";
      }

      function applyTheme(nextMode, persist = true) {
        themeMode = ["auto", "light", "dark"].includes(nextMode) ? nextMode : "auto";
        const resolvedTheme = resolveTheme(themeMode);
        root.dataset.themeMode = themeMode;
        root.dataset.theme = resolvedTheme;
        document.querySelectorAll("[data-theme-mode]").forEach((button) => {
          const selected = button.dataset.themeMode === themeMode;
          button.classList.toggle("is-active", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.content = resolvedTheme === "light" ? "#edf6fb" : "#111312";
        if (persist) {
          storePreference("portal-theme", themeMode);
          storePreference("jats:theme", resolvedTheme);
        }
        document.dispatchEvent(
          new CustomEvent("jats:theme", { detail: { mode: themeMode, theme: resolvedTheme } })
        );
      }

      document.querySelectorAll("[data-theme-mode]").forEach((button) => {
        button.addEventListener("click", () => applyTheme(button.dataset.themeMode));
      });

      function navFocusableElements() {
        return [
          ...(navRail?.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          ) || [])
        ].filter((node) => !node.hidden);
      }

      function setMobileNav(open, restoreFocus = true) {
        if (!navRail || !navToggle) return;
        if (!mobileNavQuery.matches) {
          body.classList.remove("nav-open");
          navRail.inert = false;
          navRail.removeAttribute("aria-hidden");
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Open navigation");
          if (navScrim) navScrim.tabIndex = -1;
          return;
        }

        if (open) {
          lastNavFocus = document.activeElement;
          body.classList.add("nav-open");
          navRail.inert = false;
          navRail.setAttribute("aria-hidden", "false");
          navToggle.setAttribute("aria-expanded", "true");
          navToggle.setAttribute("aria-label", "Close navigation");
          if (navScrim) navScrim.tabIndex = 0;
          requestAnimationFrame(() => {
            const current = navRail.querySelector('[aria-current="page"]');
            (current || navFocusableElements()[0])?.focus();
          });
          return;
        }

        if (navRail.contains(document.activeElement)) {
          navToggle.focus();
        }
        body.classList.remove("nav-open");
        navToggle.setAttribute("aria-expanded", "false");
        navToggle.setAttribute("aria-label", "Open navigation");
        navRail.setAttribute("aria-hidden", "true");
        navRail.inert = true;
        if (navScrim) navScrim.tabIndex = -1;
        if (restoreFocus && lastNavFocus instanceof HTMLElement && document.contains(lastNavFocus)) {
          lastNavFocus.focus();
        }
      }

      navToggle?.addEventListener("click", () => {
        setMobileNav(!body.classList.contains("nav-open"));
      });
      navScrim?.addEventListener("click", () => setMobileNav(false));
      navRail?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (mobileNavQuery.matches) setMobileNav(false, false);
        });
      });

      let pointerInsideNav = false;
      navRail?.addEventListener("pointerenter", () => {
        pointerInsideNav = true;
      });
      navRail?.addEventListener("click", (event) => {
        if (mobileNavQuery.matches || event.target.closest("a, button")) return;
        navRail.classList.toggle("is-expanded");
      });
      navRail?.addEventListener("keydown", (event) => {
        if (mobileNavQuery.matches || !["Enter", " "].includes(event.key)) return;
        if (event.target !== navRail) return;
        event.preventDefault();
        navRail.classList.toggle("is-expanded");
      });
      navRail?.addEventListener("mouseleave", () => {
        pointerInsideNav = false;
        navRail.classList.remove("is-expanded");
      });
      navRail?.addEventListener("focusout", () => {
        setTimeout(() => {
          if (!pointerInsideNav && !navRail.contains(document.activeElement)) {
            navRail.classList.remove("is-expanded");
          }
        }, 0);
      });

      addEventListener("keydown", (event) => {
        if (event.key === "Escape" && body.classList.contains("nav-open")) {
          event.preventDefault();
          setMobileNav(false);
          return;
        }
        if (
          event.key !== "Tab" ||
          !mobileNavQuery.matches ||
          !body.classList.contains("nav-open")
        ) {
          return;
        }
        const focusable = navFocusableElements();
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      const syncNavMode = () => setMobileNav(false, false);
      mobileNavQuery.addEventListener?.("change", syncNavMode);

      applyLanguage(language);
      applyTheme(themeMode);
      syncNavMode();
      setInterval(() => {
        if (themeMode === "auto") applyTheme("auto", false);
      }, 60000);
      delete root.dataset.languagePending;
    </script>
    <slot name="scripts" />
  </body>
</html>
